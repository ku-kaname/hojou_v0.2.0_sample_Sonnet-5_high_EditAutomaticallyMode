# データベース接続
POSTGRES_USER=hojou_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hojou_app
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://hojou_app:change_me@db:5432/hojou_app

# JWT認証
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS（フロントエンド開発サーバーのオリジン。複数指定時はカンマ区切り）
CORS_ALLOWED_ORIGINS=http://localhost:5173

# フロントエンドからのAPIベースURL（開発時のみ使用。本番はNginx経由の同一オリジン）
VITE_API_BASE_URL=http://localhost:8000
